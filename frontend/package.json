{
  "name": "turnglass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"**/*.vue\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "generate:api": "openapi-typescript http://127.0.0.1:5278/openapi/v1.json -o src/api/generated.ts"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/vue": "1.77.0",
    "@unovis/ts": "1.8.1",
    "@unovis/vue": "1.8.1",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "reka-ui": "2.11.0",
    "vue": "3.5.46",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "27.2.0",
    "openapi-typescript": "7.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.1.4"
  }
}
